{
	"name": "summercamp-quiz",
	"version": "1.0.0",
	"description": "LAN内で使うオフラインイベント向けクイズシステム",
	"scripts": {
		"dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
		"dev:server": "node --watch --disable-warning=ExperimentalWarning src/server/index.ts",
		"dev:client": "vite",
		"build": "vite build",
		"start": "NODE_ENV=production node --disable-warning=ExperimentalWarning src/server/index.ts",
		"typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hakatashi/summercamp-quiz.git"
	},
	"author": "hakatashi",
	"license": "MIT",
	"type": "module",
	"bugs": {
		"url": "https://github.com/hakatashi/summercamp-quiz/issues"
	},
	"homepage": "https://github.com/hakatashi/summercamp-quiz#readme",
	"dependencies": {
		"@hono/node-server": "^2.1.1",
		"hono": "^4.13.8",
		"katex": "^0.18.9",
		"qrcode": "^1.5.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0",
		"socket.io": "^4.8.3",
		"socket.io-client": "^4.8.3",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^24.13.6",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "^10.0.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"private": true,
	"engines": {
		"node": ">=24"
	}
}
